# Geocoder offline (VM sin internet) — todo local, sin internet.
GEOCODER_DB_PATH=./data/cuba_routing_full.db
# GEOCODER_DATA_DIR no es opcional: el paquete está instalado dentro de .venv, y
# sin esta variable config.py deduce la ruta de los datos a partir de __file__ y
# apunta dentro del venv — el mapa (/tiles) devolvería 404 en silencio.
GEOCODER_DATA_DIR=./data
GEOCODER_PORT=8034
